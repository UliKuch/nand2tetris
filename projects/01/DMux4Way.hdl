// File name: projects/01/DMux4Way.hdl

/**
 * 4-way demultiplexor:
 * {a, b, c, d} = {in, 0, 0, 0} if sel == 00
 *                {0, in, 0, 0} if sel == 01
 *                {0, 0, in, 0} if sel == 10
 *                {0, 0, 0, in} if sel == 11
 */

CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    Not (in=sel[0], out=nsel0);
    Not (in=sel[1], out=nsel1);
    And (a=nsel0, b=nsel1, out=res1);
    DMux (in=in, sel=res1, a=res2, b=a);
    And (a=sel[0], b=nsel1, out=res3);
    DMux (in=res2, sel=res3, a=res4, b=b);
    And (a=sel[1], b=nsel0, out=res5);
    DMux (in=res4, sel=res5, a=d, b=c);
}