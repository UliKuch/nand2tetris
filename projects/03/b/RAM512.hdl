// File name: projects/03/b/RAM512.hdl

/**
 * Memory of 512 registers, each 16 bit-wide. Out holds the value
 * stored at the memory location specified by address. If load==1, then 
 * the in value is loaded into the memory location specified by address 
 * (the loaded value will be emitted to out from the next time step onward).
 */

CHIP RAM512 {
    IN in[16], load, address[9];
    OUT out[16];

    PARTS:
    DMux8Way (in=load, sel[0..2]=address[6..8],
        a=loada, b=loadb, c=loadc, d=loadd, e=loade, f=loadf, g=loadg, h=loadh);

    RAM64 (in=in, out=ina, load=loada, address[0..5]=address[0..5]);
    RAM64 (in=in, out=inb, load=loadb, address[0..5]=address[0..5]);
    RAM64 (in=in, out=inc, load=loadc, address[0..5]=address[0..5]);
    RAM64 (in=in, out=ind, load=loadd, address[0..5]=address[0..5]);
    RAM64 (in=in, out=ine, load=loade, address[0..5]=address[0..5]);
    RAM64 (in=in, out=inf, load=loadf, address[0..5]=address[0..5]);
    RAM64 (in=in, out=ing, load=loadg, address[0..5]=address[0..5]);
    RAM64 (in=in, out=inh, load=loadh, address[0..5]=address[0..5]);

    Mux8Way16(a=ina, b=inb, c=inc, d=ind, e=ine, f=inf, g=ing, h=inh,
        sel[0..2]=address[6..8], out=out);
}