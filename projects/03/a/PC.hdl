/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];

    PARTS:
    // nulls
    Not16 (in=in, out=notin);
    And16 (a=in, b=notin, out=nulin);

    Inc16 (in=regout, out=incin);

    // incrementing or loading...
    Mux16 (a=incin, b=in, sel=load, out=loadout);    
    // ...or resetting
    Mux16 (a=loadout, b=nulin, sel=reset, out=resetout);

    // Change output if any control bit is present
    Or (a=load, b=inc, out=loadorinc);
    Or (a=loadorinc, b=reset, out=somebit);

    Register (in=resetout, out=out, out=regout, load=somebit);
}
